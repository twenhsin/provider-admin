          "$type": "color",
          "$value": "{border.disabled}"
        }
      },
      "text": {
        "default": {
          "$type": "color",
          "$value": "{text.default}"
        }
      },
      "background": {
        "default": {
          "$type": "color",
          "$value": "{background.page}"
        }
      }
    }
  }
}
